#!/bin/sh /etc/rc.common
START=99
STOP=10

start() {
    # Kill any existing process first
    killall sing-box-tiny 2>/dev/null
    sleep 1
    killall -9 sing-box-tiny 2>/dev/null
    sleep 1

    export GOGC=20
    export GOMEMLIMIT=40MiB

    mkdir -p /var/run /var/lock
    /usr/bin/sing-box-tiny run -c /etc/sing-box/config.json </dev/null >/dev/null 2>&1 &
    echo $! > /var/run/sing-box-tiny.pid
}

stop() {
    killall sing-box-tiny 2>/dev/null
    sleep 1
    killall -9 sing-box-tiny 2>/dev/null
    rm -f /var/run/sing-box-tiny.pid
}
